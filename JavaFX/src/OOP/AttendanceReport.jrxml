<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="AttendanceReport" language="java"
    pageWidth="595" pageHeight="842"
    columnWidth="555" leftMargin="20" rightMargin="20"
    topMargin="20" bottomMargin="20">

    <!-- All text is plain black — no conditional color styles -->
    <style name="StatusStyle" isDefault="false" forecolor="#000000" isBold="true"/>

    <queryString language="SQL">
        <![CDATA[SELECT id, student_name, date, status FROM records ORDER BY date DESC, student_name ASC]]>
    </queryString>

    <field name="id"           class="java.lang.Integer"/>
    <field name="student_name" class="java.lang.String"/>
    <field name="date"         class="java.lang.String"/>
    <field name="status"       class="java.lang.String"/>

    <!-- ── TITLE ─────────────────────────────────────────────── -->
    <title>
        <band height="80" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="5" width="555" height="36"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[Daily Attendance Report]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="42" width="555" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isItalic="true"/>
                </textElement>
                <text><![CDATA[Attendance Management System — ADKJ]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="65" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <!-- ── COLUMN HEADERS — dark background kept, text white ─── -->
    <columnHeader>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30" backcolor="#1a237e" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="0" width="50" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle" textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="0" width="250" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Student Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="300" y="0" width="130" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Date]]></text>
            </staticText>

            <staticText>
                <reportElement x="430" y="0" width="125" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ── DETAIL ROWS — all plain black ─────────────────────── -->
    <detail>
        <band height="24" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="50" height="24"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="50" y="0" width="250" height="24"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{student_name}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="300" y="0" width="130" height="24"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>

            <!-- Status — plain black bold, no color conditionals -->
            <textField>
                <reportElement x="430" y="0" width="125" height="24" style="StatusStyle"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="23" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#cccccc"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <!-- ── PAGE FOOTER — date left, page number right ─────────── -->
    <pageFooter>
        <band height="28" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#aaaaaa"/>
                </graphicElement>
            </line>

            <!-- Left: printed date -->
            <textField>
                <reportElement x="0" y="6" width="300" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Date Printed: " + new java.text.SimpleDateFormat("MMMM dd, yyyy").format(new java.util.Date())]]>
                </textFieldExpression>
            </textField>

            <!-- Right: "Page X of Y" -->
            <textField>
                <reportElement x="390" y="6" width="80" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="472" y="6" width="83" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ── SUMMARY ───────────────────────────────────────────── -->
    <summary>
        <band height="50" splitType="Stretch">
            <line>
                <reportElement x="0" y="5" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="350" y="15" width="110" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true" size="11"/>
                </textElement>
                <text><![CDATA[Total Records:]]></text>
            </staticText>

            <textField>
                <reportElement x="465" y="15" width="90" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
